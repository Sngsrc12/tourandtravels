# MongoDB Atlas - replace <db_password> with the real password of the
# samikshatechsolutions_db_user database user.
# If the password contains special characters (e.g. @, :, /, #), URL-encode them
# (example: @ -> %40).
#
# NOTE: This is the DIRECT (non-SRV) connection string. It avoids DNS SRV
# lookups, which fail/slow down inside serverless runtimes like Vercel.
# Do NOT set this to the mongodb+srv:// form on Vercel, or the app will break.
MONGODB_URI=mongodb://samikshatechsolutions_db_user:Mangeeta_143@ac-a1autld-shard-00-00.zkvxset.mongodb.net:27017,ac-a1autld-shard-00-01.zkvxset.mongodb.net:27017,ac-a1autld-shard-00-02.zkvxset.mongodb.net:27017/?authSource=admin&replicaSet=atlas-mstiqq-shard-0&retryWrites=true&w=majority&tls=true

# Which database to use. If your data lives in 'Data' or 'str' instead,
# change this to that name.
MONGODB_DB_NAME=MyTraveldata

# ImageKit - optional, falls back to the key hardcoded in main.py
IMAGEKIT_PRIVATE_KEY=
