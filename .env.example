# Copy this file to .env and fill in real values. Never commit .env to git.

# IMPORTANT: use the DIRECT (non-SRV) connection string, NOT mongodb+srv://.
# The SRV form needs DNS SRV lookups that are slow/unreliable inside serverless
# runtimes (Vercel/Render) and cause timeouts -> 500/504 -> "network error" in
# the frontend. The direct form only needs plain A-record lookups.
MONGODB_URI=mongodb://samikshatechsolutions_db_user:<db_password>@ac-a1autld-shard-00-00.zkvxset.mongodb.net:27017,ac-a1autld-shard-00-01.zkvxset.mongodb.net:27017,ac-a1autld-shard-00-02.zkvxset.mongodb.net:27017/?authSource=admin&replicaSet=atlas-mstiqq-shard-0&retryWrites=true&w=majority&tls=true
MONGODB_DB_NAME=MyTraveldata

IMAGEKIT_PRIVATE_KEY=
